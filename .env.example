# PostgreSQL
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5433/lifeos?schema=public"
DATABASE_URL_TEST="postgresql://user:password@host/database?sslmode=require"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email OTP (Resend: free tier is suitable for early development)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="KASA <login@your-domain.com>"

# Phone OTP provider adapter. Point this at your SMS provider/serverless webhook.
# The webhook receives: { to, code, purpose, brand }.
AUTH_SMS_WEBHOOK_URL=""
AUTH_SMS_WEBHOOK_SECRET=""

# OpenAI-powered Smart Inbox classification
OPENAI_API_KEY=""
OPENAI_CAPTURE_MODEL="gpt-4o-mini"
OPENAI_AUTOMATION_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Private KASA attachments (S3-compatible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
KASA_DOCUMENTS_S3_PREFIX="kasa-lifeos"
