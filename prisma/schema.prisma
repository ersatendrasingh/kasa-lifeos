// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  sessions              Session[]
  passkeys              Passkey[]
  profile               UserProfile?
  captures              Capture[]
  tasks                 Task[]
  reminders             Reminder[]
  responsibilities      Responsibility[]
  calendarEvents        CalendarEvent[]
  checklists            Checklist[]
  ideas                 Idea[]
  expenses              Expense[]
  shoppingItems         ShoppingItem[]
  wishes                Wish[]
  timelineEvents        TimelineEvent[]
  notifications         Notification[]
  dashboardItems        DashboardWidget[]
  automationConnections AutomationConnection[]
  automationPolicies    AutomationPolicy[]
  automationEvents      AutomationEvent[]
  automationActions     AutomationAction[]
  automationAttachments AutomationAttachment[]
  lifeRecords           LifeRecord[]
  documents             Document[]
  documentCategories    DocumentCategory[]
  healthEntries         HealthEntry[]
  medicinePlans         MedicinePlan[]
  people                Person[]
  personMemories        PersonMemory[]
  missions              Mission[]
}

// Every measurement, activity and wellness check-in shares this shape. Device
// connectors normalize their payload before writing here, so consumers never
// need provider-specific branches.
model HealthEntry {
  id         String   @id @default(cuid())
  userId     String
  type       String
  value      Decimal  @db.Decimal(14, 3)
  unit       String
  source     String   @default("manual")
  recordedAt DateTime
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt(sort: Desc)])
  @@index([userId, recordedAt(sort: Desc)])
  @@index([source, recordedAt(sort: Desc)])
}

// A medicine plan is optional. It turns a treatment schedule into calm,
// individually timed reminders; a generic "medicine" check-in alone never
// assumes that someone takes medication.
model MedicinePlan {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dose      String?
  times     Json
  startDate DateTime
  endDate   DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, startDate])
}

// A person is deliberately richer than a device contact. It is the private
// relationship profile that connects practical details with remembered context.
model Person {
  id             String   @id @default(cuid())
  userId         String
  name           String
  phone          String?
  email          String?
  company        String?
  role           String?
  category       String   @default("FRIEND")
  tags           Json?
  birthday       DateTime?
  anniversary    DateTime?
  address        String?  @db.Text
  trustLevel     Int      @default(3)
  favorite       Boolean  @default(false)
  bloodGroup     String?
  emergency      Boolean  @default(false)
  lastContactAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories       PersonMemory[]

  @@index([userId, favorite, updatedAt(sort: Desc)])
  @@index([userId, category, updatedAt(sort: Desc)])
  @@index([userId, lastContactAt])
}

// Notes, interactions, document references and future AI summaries share one
// chronological memory stream, so a profile never becomes a collection of tabs.
model PersonMemory {
  id         String   @id @default(cuid())
  userId     String
  personId   String
  kind       String   @default("NOTE")
  title      String
  detail     String?  @db.Text
  occurredAt DateTime @default(now())
  sourceType String?
  sourceId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, occurredAt(sort: Desc)])
  @@index([userId, kind, occurredAt(sort: Desc)])
}

model Mission {
  id          String   @id @default(cuid())
  userId      String
  title       String
  category    String
  description String?  @db.Text
  targetValue Decimal? @db.Decimal(14, 2)
  currentValue Decimal? @db.Decimal(14, 2)
  unit        String?
  targetDate  DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  MissionMilestone[]

  @@index([userId, status, updatedAt(sort: Desc)])
}

model MissionMilestone {
  id          String   @id @default(cuid())
  missionId   String
  title       String
  completedAt DateTime?
  position    Int
  createdAt   DateTime @default(now())
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, position])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  issuer                String
  accountId             String
  providerId            String
  refreshToken          String?   @db.Text
  accessToken           String?   @db.Text
  scope                 String?
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String   @db.Text
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// KASA personalized platform foundation
// ─────────────────────────────────────────────────────────────────────────────

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredName      String?
  timezone           String   @default("Asia/Kolkata")
  locale             String   @default("en-IN")
  currency           String   @default("INR")
  weekStartsOn       Int      @default(1)
  quietHoursStart    String?
  quietHoursEnd      String?
  onboardingComplete Boolean  @default(false)
  preferences        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardWidget {
  id        String              @id @default(cuid())
  userId    String
  type      DashboardWidgetType
  position  Int
  size      DashboardWidgetSize @default(MEDIUM)
  enabled   Boolean             @default(true)
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, enabled, position])
}

// Every unstructured thought lands here first. A classifier can later promote
// it to one typed entity while retaining the original input and audit trail.
model Capture {
  id              String            @id @default(cuid())
  userId          String
  rawText         String            @db.Text
  normalizedTitle String
  category        CaptureCategory
  status          CaptureStatus     @default(CLASSIFIED)
  classifier      CaptureClassifier @default(RULES)
  confidence      Float
  source          CaptureSource     @default(WEB)
  dueAt           DateTime?
  amount          Decimal?          @db.Decimal(14, 2)
  currency        String?
  metadata        Json?
  classifiedAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task?
  reminder        Reminder?
  idea            Idea?
  expense         Expense?
  shoppingItem    ShoppingItem?
  wish            Wish?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category, status])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  captureId   String?    @unique
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Int        @default(2)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture     Capture?   @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
}

model Reminder {
  id            String         @id @default(cuid())
  userId        String
  captureId     String?        @unique
  title         String
  notes         String?        @db.Text
  remindAt      DateTime
  status        ReminderStatus @default(SCHEDULED)
  recurrence    Json?
  targetType    String?
  targetId      String?
  lastTriggered DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture       Capture?       @relation(fields: [captureId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([userId, status, remindAt])
  @@index([status, remindAt])
}

// A recurring responsibility is deliberately separate from one-off reminders.
// It owns the due cadence and is advanced only when the person confirms the
// current cycle is paid/completed.
model Responsibility {
  id               String                  @id @default(cuid())
  userId           String
  title            String
  area             String
  provider         String?
  cadence          ResponsibilityCadence  @default(MONTHLY)
  dueDay           Int?
  nextDueAt        DateTime
  notificationDays Json
  amount           Decimal?                @db.Decimal(14, 2)
  currency         String?                 @db.VarChar(3)
  active           Boolean                 @default(true)
  lastPaidAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments         ResponsibilityPayment[]

  @@index([userId, active, nextDueAt])
}

model ResponsibilityPayment {
  id               String         @id @default(cuid())
  responsibilityId String
  dueAt            DateTime
  paidAt           DateTime       @default(now())
  amount           Decimal?       @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)

  @@index([responsibilityId, paidAt(sort: Desc)])
}

// A first-class plan on the user's calendar. Timeline is history; calendar is
// the forward-looking place where commitments, reminders and plans meet.
model CalendarEvent {
  id            String      @id @default(cuid())
  userId        String
  sourceEventId String?
  title         String
  notes         String?     @db.Text
  startsAt      DateTime
  endsAt        DateTime?
  allDay        Boolean     @default(true)
  budgetAmount  Decimal?    @db.Decimal(14, 2)
  currency      String?     @db.VarChar(3)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklists    Checklist[]

  @@index([userId, startsAt])
  @@index([sourceEventId])
}

model Checklist {
  id              String          @id @default(cuid())
  userId          String
  calendarEventId String?
  title           String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvent   CalendarEvent?  @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  items           ChecklistItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([calendarEventId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, position])
}

model Idea {
  id        String     @id @default(cuid())
  userId    String
  captureId String?    @unique
  title     String
  body      String?    @db.Text
  status    IdeaStatus @default(INBOX)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture   Capture?   @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt(sort: Desc)])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  captureId   String?  @unique
  title       String
  amount      Decimal? @db.Decimal(14, 2)
  currency    String   @default("INR")
  category    String?
  merchant    String?
  occurredAt  DateTime @default(now())
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture     Capture? @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, isConfirmed])
}

model ShoppingItem {
  id        String             @id @default(cuid())
  userId    String
  captureId String?            @unique
  title     String
  quantity  Decimal?           @db.Decimal(10, 2)
  unit      String?
  status    ShoppingItemStatus @default(TO_BUY)
  url       String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture   Capture?           @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt(sort: Desc)])
}

model Wish {
  id           String     @id @default(cuid())
  userId       String
  captureId    String?    @unique
  title        String
  notes        String?    @db.Text
  status       WishStatus @default(WISHED)
  targetAmount Decimal?   @db.Decimal(14, 2)
  currency     String?    @default("INR")
  targetDate   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capture      Capture?   @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([userId, status, targetDate])
}

model TimelineEvent {
  id         String             @id @default(cuid())
  userId     String
  type       TimelineEventType
  title      String
  summary    String?            @db.Text
  occurredAt DateTime           @default(now())
  sourceType String?
  sourceId   String?
  visibility TimelineVisibility @default(PRIVATE)
  hiddenAt   DateTime?
  metadata   Json?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, hiddenAt, occurredAt(sort: Desc)])
  @@index([userId, type, occurredAt(sort: Desc)])
  @@index([sourceType, sourceId])
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  reminderId  String?
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  title       String
  body        String?             @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  readAt      DateTime?
  attempts    Int                 @default(0)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder    Reminder?           @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

// Every external or user-initiated signal enters the same auditable pipeline.
// Provider credentials are intentionally not stored here; production connectors
// use the auth provider's encrypted token store or a dedicated secrets service.
model AutomationConnection {
  id                String                     @id @default(cuid())
  userId            String
  provider          AutomationProvider
  status            AutomationConnectionStatus @default(AVAILABLE)
  externalAccountId String?
  displayName       String?
  scopes            Json?
  settings          Json?
  lastSyncAt        DateTime?
  errorMessage      String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            AutomationEvent[]

  @@unique([userId, provider])
  @@index([userId, status])
}

model AutomationPolicy {
  id             String               @id @default(cuid())
  userId         String
  source         AutomationSource
  mode           AutomationPolicyMode @default(REVIEW_FIRST)
  allowedActions Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
}

model AutomationEvent {
  id               String                 @id @default(cuid())
  userId           String
  connectionId     String?
  source           AutomationSource
  sourceExternalId String?
  contentType      String                 @default("text/plain")
  rawText          String?                @db.Text
  status           AutomationEventStatus  @default(PROCESSING)
  summary          String?                @db.Text
  confidence       Float?
  occurredAt       DateTime               @default(now())
  processedAt      DateTime?
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       AutomationConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  actions          AutomationAction[]
  attachments      AutomationAttachment[]
  lifeRecords      LifeRecord[]

  @@unique([userId, source, sourceExternalId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

model AutomationAttachment {
  id               String           @id @default(cuid())
  userId           String
  eventId          String?
  objectKey        String           @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  kind             String
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            AutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventId])
}

model AutomationAction {
  id             String                 @id @default(cuid())
  userId         String
  eventId        String
  type           AutomationActionType
  status         AutomationActionStatus @default(PROPOSED)
  title          String
  confidence     Float
  requiresReview Boolean                @default(true)
  payload        Json
  result         Json?
  executedAt     DateTime?
  errorMessage   String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          AutomationEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([eventId])
}

// A lightweight life graph record lets automation create useful entities now
// (vehicle, document, subscription, trip, person) before every specialist
// module gets its richer typed schema.
model LifeRecord {
  id            String           @id @default(cuid())
  userId        String
  sourceEventId String?
  type          LifeRecordType
  title         String
  status        String           @default("ACTIVE")
  occurredAt    DateTime?
  expiresAt     DateTime?
  attributes    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvent   AutomationEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([userId, expiresAt])
}

enum CaptureCategory {
  TASK
  REMINDER
  IDEA
  EXPENSE
  SHOPPING
  WISH
}

enum CaptureStatus {
  PROCESSING
  CLASSIFIED
  NEEDS_REVIEW
  ARCHIVED
}

enum CaptureClassifier {
  RULES
  AI
  USER
}

enum CaptureSource {
  WEB
  MOBILE
  VOICE
  IMPORT
}

enum AutomationProvider {
  GMAIL
  GOOGLE_CALENDAR
  APPLE_CALENDAR
  SMS
  APPLE_HEALTH
  HEALTH_CONNECT
  PHOTOS
  LOCATION
  CONTACTS
  NOTIFICATIONS
  BROWSER_EXTENSION
  WHATSAPP
}

enum AutomationConnectionStatus {
  AVAILABLE
  CONNECTING
  CONNECTED
  PAUSED
  ERROR
}

enum AutomationSource {
  MANUAL_TEXT
  VOICE
  CAMERA
  DOCUMENT
  EMAIL
  CALENDAR
  SMS
  HEALTH
  LOCATION
  CONTACTS
  NOTIFICATION
  BROWSER
  WHATSAPP
}

enum AutomationPolicyMode {
  REVIEW_FIRST
  AUTO_SAFE
  PAUSED
}

enum AutomationEventStatus {
  PROCESSING
  ACTIONED
  NEEDS_REVIEW
  IGNORED
  FAILED
}

enum AutomationActionType {
  ADD_TIMELINE_EVENT
  CREATE_TASK
  CREATE_REMINDER
  CREATE_CALENDAR_EVENT
  CREATE_CHECKLIST
  LOG_EXPENSE
  ADD_SHOPPING_ITEM
  ADD_WISH
  SAVE_IDEA
  UPSERT_LIFE_RECORD
}

enum AutomationActionStatus {
  PROPOSED
  NEEDS_REVIEW
  EXECUTED
  REJECTED
  FAILED
}

enum LifeRecordType {
  DOCUMENT
  VEHICLE
  SUBSCRIPTION
  PURCHASE
  TRIP
  APPOINTMENT
  PERSON
  HEALTH
  CAREER
  HOME
  LEARNING
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ReminderStatus {
  SCHEDULED
  TRIGGERED
  SNOOZED
  COMPLETED
  CANCELLED
}

enum ResponsibilityCadence {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum IdeaStatus {
  INBOX
  EXPLORING
  PLANNED
  ARCHIVED
}

enum ShoppingItemStatus {
  TO_BUY
  BOUGHT
  SKIPPED
}

enum WishStatus {
  WISHED
  SAVING
  ACHIEVED
  ARCHIVED
}

enum TimelineEventType {
  CAPTURED
  TASK_COMPLETED
  REMINDER_TRIGGERED
  DOCUMENT_ADDED
  FINANCE
  HEALTH
  CAREER
  LEARNING
  RELATIONSHIP
  VEHICLE
  HOME
  ACHIEVEMENT
  NOTE
}

enum TimelineVisibility {
  PRIVATE
  SHARED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
  CANCELLED
}

enum DashboardWidgetType {
  TODAY_SCORE
  STREAK
  FOCUS
  QUICK_CAPTURE
  PENDING_BILLS
  UPCOMING_EVENTS
  HABITS
  FINANCE
  FOLLOW_UPS
  BIRTHDAYS
  LEARNING
}

enum DashboardWidgetSize {
  SMALL
  MEDIUM
  LARGE
  FULL
}

/// A document stored in Life Vault. The goal of this module is that any
/// important document is findable within 30 seconds, so there is deliberately
/// no folder hierarchy — everything is reached through search, favourites and
/// flat categories, the way Apple Photos works.
model Document {
  id               String             @id @default(cuid())
  userId           String
  /// S3 object key. The file itself is the only place a full identity number
  /// exists; see `idNumberMasked` for why nothing sensitive is stored in a
  /// queryable column.
  objectKey        String             @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  /// IMAGE | PDF | DOCUMENT, matching lib/storage/s3.ts `attachmentKind`.
  kind             String
  title            String
  /// One of the built-in slugs (identity, financial, ...) or a custom
  /// DocumentCategory slug owned by this user. Kept as a string rather than an
  /// enum so user-created categories need no migration.
  categorySlug     String             @default("others")
  /// Alternative names the user might search by, supplied by AI extraction:
  /// a driving licence gets ["DL", "Licence", "Driving Licence"], so searching
  /// "DL" finds it even though the title says something else.
  aliases          String[]           @default([])
  tags             String[]           @default([])
  /// Full text read off the document, used for search. Identity numbers are
  /// masked out of this text before it is written.
  ocrText          String?            @db.Text
  /// Identity numbers are stored masked (e.g. "XXXX XXXX 1234") so a database
  /// compromise cannot expose them. Only `idNumberLast4` is searchable, which
  /// keeps "search by the last digits" working.
  idNumberMasked   String?
  idNumberLast4    String?
  issuedOn         DateTime?
  expiresAt        DateTime?
  favorite         Boolean            @default(false)
  notes            String?            @db.Text
  /// AI confidence in the extracted fields (0-1), null when extraction was
  /// skipped or unavailable. Drives whether the review sheet flags a field.
  aiConfidence     Float?
  /// Raw AI extraction payload, retained so fields can be re-derived later
  /// without re-reading the file through the model.
  aiMetadata       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders        DocumentReminder[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, categorySlug, updatedAt(sort: Desc)])
  @@index([userId, favorite])
  @@index([userId, expiresAt])
}

/// User-defined category, so people can add their own alongside the built-ins.
model DocumentCategory {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  label     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

/// Scheduled expiry warning for a document, one row per lead time so each can
/// be sent and tracked independently.
model DocumentReminder {
  id         String         @id @default(cuid())
  documentId String
  /// Days before expiry this reminder fires. KASA selects a renewal-aware
  /// sequence (for example 180/90/30/15/7 for passports and insurance).
  leadDays   Int
  remindAt   DateTime
  status     ReminderStatus @default(SCHEDULED)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, leadDays])
  @@index([status, remindAt])
}
